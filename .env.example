# GlideTherm — Environment configuration
# Copy this file to .env.local for local development overrides.
# Never commit a real .env file.

# ─────────────────────────────────────────────────────────────────
# PRODUCTION (set automatically in Amplify build environment)
# ─────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com
#
# Leave unset for local development — Vite proxy handles /api → localhost:5001

# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (optional overrides)
# ─────────────────────────────────────────────────────────────────
# PORT=5001  (backend port, default: 5001)
